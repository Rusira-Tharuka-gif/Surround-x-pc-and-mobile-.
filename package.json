{
  "name": "surround-x",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release dist-electron",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/channelMath.test.ts src/utils/waveMath.test.ts src/utils/audioHeader.test.ts src/utils/backgroundConversion.test.ts src/utils/fileDownload.test.ts",
    "cap:sync": "npm run build && npx cap sync android",
    "electron:dev": "node electron/dev.mjs",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win --publish never",
    "electron:build:nsis": "npm run build && electron-builder --win nsis --publish never",
    "electron:build:portable": "npm run build && electron-builder --win portable --publish never",
    "build:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.surroundx.studio",
    "productName": "Surround X",
    "copyright": "Copyright © 2026 Surround X",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/dev.mjs",
      "package.json"
    ],
    "asar": true,
    "publish": null,
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Surround X",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.exe"
    }
  }
}
